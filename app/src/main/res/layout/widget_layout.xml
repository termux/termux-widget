<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <!--
         Background layer. Its alpha is set with setImageAlpha() from TermuxWidgetProvider so that
         only the background becomes transparent and not the content layer. The launcher on
         Android 12+ also looks for the @android:id/background view for rounded corner clipping.
    -->

    <ImageView
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <!-- Content layer. Title and refresh button are inset 16dp so that they are not clipped by rounded corners. -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <LinearLayout
            android:id="@+id/top_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp" >

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/title_widget"
                android:textColor="@color/widget_text_primary"
                android:textSize="16sp" />

            <!-- Icon is 24dp, so with 8dp padding here and 8dp paddingEnd of top_row its edge is 16dp from the end. -->

            <ImageButton
                android:id="@+id/refresh_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_circle"
                android:contentDescription="@string/action_refresh"
                android:padding="8dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_row"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@color/widget_divider"
            android:dividerHeight="1px"
            android:paddingBottom="8dp" >
        </ListView>

        <!-- Shown for empty collection due to rv.setEmptyView(R.id.widget_list, R.id.empty_view) being called: -->

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_row"
            android:background="@android:color/transparent"
            android:padding="16dp"
            android:text="@string/msg_refresh_widget_from_app"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp" />
    </RelativeLayout>

</FrameLayout>
